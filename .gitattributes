# Keep line endings identical on every machine. Windows checkouts must not
# turn LF into CRLF: pinned file hashes and shell scripts depend on LF.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
aiverse-skills text eol=lf
LICENSE text eol=lf
VERSION text eol=lf

# Windows batch files keep the CRLF they were committed with.
*.cmd text eol=crlf

# Third party font license stored with CRLF: leave byte for byte.
skills/imported/anthropic/canvas-design/canvas-fonts/IBMPlexSerif-OFL.txt -text

# Binary files: never convert.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.zip binary
*.gz binary
