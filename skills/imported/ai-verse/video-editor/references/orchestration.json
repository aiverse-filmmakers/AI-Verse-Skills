{
  "schema_version": 1,
  "capability": "video-editor",
  "principle": "Preserve editorial truth first, then invoke the smallest specialist set needed to produce and verify the requested media.",
  "scopes": [
    "SILENCE_ONLY",
    "MISTAKE_RETAKE_ONLY",
    "CAPTIONS_ONLY",
    "MOTION_GRAPHICS_ONLY",
    "SHORT_FORM_EDIT",
    "LONG_FORM_TALKING_HEAD",
    "WEBSITE_PROMO",
    "REFERENCE_LED_EDIT",
    "FULL_EDIT"
  ],
  "stages": [
    {
      "id": "source_intake",
      "when": "always",
      "required": true,
      "authority": "video-editor"
    },
    {
      "id": "transcription",
      "capabilities": [
        "video.transcribe"
      ],
      "when": "transcript_missing_and_speech_relevant",
      "required": false
    },
    {
      "id": "silence_pass",
      "capabilities": [
        "video.cut.silence"
      ],
      "when": "silence_removal_requested_or_full_edit",
      "required": false
    },
    {
      "id": "mistake_review",
      "capabilities": [
        "video.cut.mistakes"
      ],
      "when": "spoken_mistake_cleanup_requested_or_full_edit",
      "required": false
    },
    {
      "id": "edl_truth",
      "capabilities": [
        "video.edl"
      ],
      "when": "timeline_changes",
      "required": true
    },
    {
      "id": "shortform_editorial",
      "capabilities": [
        "video.shortform.edit",
        "video.hook_payoff"
      ],
      "when": "short_form",
      "required": false
    },
    {
      "id": "longform_storytelling",
      "capabilities": [
        "video.longform.storytelling"
      ],
      "when": "long_form_visual_storytelling",
      "required": false
    },
    {
      "id": "reference_analysis",
      "capabilities": [
        "video.reference_analysis"
      ],
      "when": "reference_present",
      "required": false
    },
    {
      "id": "visual_plan",
      "capabilities": [
        "video.caption",
        "video.broll.plan",
        "video.motion_beats"
      ],
      "when": "visual_enrichment_requested_or_full_edit",
      "required": false
    },
    {
      "id": "style_direction",
      "capabilities": [
        "video.style_select"
      ],
      "when": "substantial_visual_direction_needed",
      "required": false
    },
    {
      "id": "interface_design_handoff",
      "capabilities": [
        "interface-designer"
      ],
      "when": "visual_direction_reference_recreation_prototype_or_motion_taste_would_materially_help",
      "required": false,
      "boundary": "presentation-only",
      "contract": "references/interface-designer-handoff.json",
      "handoff_modes": [
        "VISUAL_DIRECTION",
        "REFERENCE_RECREATION",
        "PROTOTYPE_VISUAL_DIRECTIONS",
        "MOTION_TASTE"
      ],
      "return_authority": "video-editor"
    },
    {
      "id": "hyperframes_compose",
      "capabilities": [
        "video.hyperframes.compose",
        "video.gsap.motion"
      ],
      "when": "code_driven_video_output",
      "required": false
    },
    {
      "id": "media_processing",
      "capabilities": [
        "video.ffmpeg.media"
      ],
      "when": "preprocessing_transcode_mux_or_media_operation_needed",
      "required": false
    },
    {
      "id": "structural_qa",
      "capabilities": [
        "video.qa.structural"
      ],
      "when": "timeline_or_composition_changed",
      "required": true,
      "evidence_required": true
    },
    {
      "id": "preview_and_draft",
      "capabilities": [
        "video.hyperframes.compose"
      ],
      "when": "renderable_video_project",
      "required": false,
      "evidence_required": true
    },
    {
      "id": "visual_qa",
      "capabilities": [
        "video.qa.visual"
      ],
      "when": "visual_output_changed",
      "required": false,
      "evidence_required": true
    },
    {
      "id": "audio_sync_qa",
      "capabilities": [
        "video.qa.audio_sync"
      ],
      "when": "audio_or_cut_timing_changed",
      "required": false,
      "evidence_required": true
    },
    {
      "id": "fix_and_reverify",
      "when": "any_gate_fails",
      "required": false
    },
    {
      "id": "final_render",
      "capabilities": [
        "video.render.final"
      ],
      "when": "final_encoded_delivery_requested",
      "required": false,
      "evidence_required": true
    }
  ],
  "scope_pipelines": {
    "SILENCE_ONLY": [
      "source_intake",
      "transcription",
      "silence_pass",
      "edl_truth",
      "structural_qa",
      "audio_sync_qa"
    ],
    "MISTAKE_RETAKE_ONLY": [
      "source_intake",
      "transcription",
      "mistake_review",
      "edl_truth",
