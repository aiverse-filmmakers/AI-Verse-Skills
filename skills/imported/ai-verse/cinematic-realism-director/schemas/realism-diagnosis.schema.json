{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiverse.local/schemas/cinematic-realism-director/realism-diagnosis.schema.json",
  "title": "AI-Verse Realism Diagnosis",
  "description": "Structured diagnosis for an existing still image that appears synthetic, physically inconsistent, overprocessed, or otherwise in need of photographic realism repair. The schema separates evidence, severity, preservation constraints, repair targets, allowed changes, strategy, and verification so repair does not become uncontrolled regeneration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "overall_assessment",
    "findings",
    "preserve",
    "repair",
    "allow_change",
    "repair_strategy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "diagnosis_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "overall_assessment": {
      "$ref": "#/$defs/overallAssessment"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "default": []
    },
    "preserve": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundaryItem"
      },
      "default": []
    },
    "repair": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repairItem"
      },
      "default": []
    },
    "allow_change": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundaryItem"
      },
      "default": []
    },
    "repair_strategy": {
      "$ref": "#/$defs/repairStrategy"
    },
    "provider_handoff": {
      "$ref": "#/$defs/providerHandoff"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_available", "analysis_basis"],
      "properties": {
        "image_available": {
          "type": "boolean"
        },
        "source_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "analysis_basis": {
          "type": "string",
          "enum": [
            "direct_visual_inspection",
            "user_description_only",
            "visual_inspection_plus_user_constraints"
          ]
        },
        "user_goal": {
          "$ref": "#/$defs/nullableString"
        },
        "preservation_priority": {
          "type": "string",
          "enum": ["strict", "high", "moderate", "loose"],
          "default": "high"
        }
      }
    },
    "overallAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artificiality_level", "severity_score", "summary", "repairability"],
      "properties": {
        "artificiality_level": {
          "type": "string",
          "enum": ["none", "minor", "moderate", "strong", "severe"]
        },
        "severity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "repairability": {
          "type": "string",
          "enum": [
            "targeted_edit_likely",
            "multi_pass_edit_likely",
            "regeneration_may_be_needed",
            "insufficient_information"
          ]
        },
        "dominant_failure_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain"
          },
          "uniqueItems": true,
          "default": []
        },
        "uncertainty": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "perspective_geometry",
        "camera_position",
        "depth_of_field",
        "focus_transition",
        "lighting_motivation",
        "light_direction",
        "light_quality",
        "shadow_behavior",
        "exposure",
        "highlight_rolloff",
        "color_white_balance",
        "color_grade",
        "skin",
        "hair",
        "eyes",
        "anatomy",
        "fabric",
        "materials",
        "surface_roughness",
        "reflections",
        "refractions",
        "contact_shadows",
        "gravity_weight",
        "environment_interaction",
        "atmospheric_depth",
        "grain_noise",
        "halation_bloom",
        "flare",
        "sharpness_detail",
        "motion_blur",
        "composition",
        "repetition_patterning",
        "text_geometry",
        "object_geometry",
        "continuity",
        "other"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "severity", "evidence", "diagnosis", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "diagnosis": {
          "type": "string",
          "minLength": 1
        },
        "likely_cause": {
          "$ref": "#/$defs/nullableString"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Carrier value only. Task 2.4 defines confidence thresholds and language semantics."
        },
        "visual_impact": {
          "type": "string",
          "enum": ["local", "regional", "global"]
        },
        "preservation_conflict": {
          "type": "boolean",
          "default": false
        },
        "related_subject_or_region": {
          "$ref": "#/$defs/nullableString"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        }
      }
    },
    "boundaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "scope"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "identity",
            "pose",
            "expression",
            "wardrobe",
            "product_design",
            "logo_text",
            "composition",
            "framing",
            "camera_angle",
            "camera_position",
            "scene_layout",
            "subject_count",
            "geometry",
            "lighting",
            "color",
            "texture",
            "background",
            "foreground",
            "other"
          ]
        },
        "strictness": {
          "type": "string",
          "enum": ["exact", "very_high", "high", "moderate"],
          "default": "high"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        },
        "source": {
          "type": "string",
          "enum": ["user_explicit", "workflow_default", "reference_role", "inferred_from_goal"],
          "default": "workflow_default"
        }
      }
    },
    "repairItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "domain", "action", "priority"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "source_finding_ids": {
          "$ref": "#/$defs/stringList"
        },
        "preserve_while_repairing": {
          "$ref": "#/$defs/stringList"
        },
        "success_condition": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "repairStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_type", "ordered_steps", "minimal_change_policy"],
      "properties": {
        "strategy_type": {
          "type": "string",
          "enum": [
            "single_targeted_edit",
            "multi_region_edit",
            "multi_pass_repair",
            "preservation_aware_regeneration",
            "diagnosis_only"
          ]
        },
        "ordered_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "instruction", "targets"],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "$ref": "#/$defs/stringList"
              },
              "preserve": {
                "$ref": "#/$defs/stringList"
              },
              "verification_after_step": {
                "$ref": "#/$defs/stringList"
              }
            }
          },
          "minItems": 1
        },
        "minimal_change_policy": {
          "type": "string",
          "minLength": 1
        },
        "regeneration_threshold": {
          "$ref": "#/$defs/nullableString"
        },
        "stop_conditions": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "providerHandoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/nullableString"
        },
        "model": {
          "$ref": "#/$defs/nullableString"
        },
        "operation": {
          "type": ["string", "null"],
          "enum": ["edit", "inpaint", "reimagine", "regenerate", "prompt_only", null]
        },
        "edit_prompt": {
          "$ref": "#/$defs/nullableString"
        },
        "negative_or_avoidance_guidance": {
          "$ref": "#/$defs/nullableString"
        },
        "native_controls": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "known_limitations": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "verification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_run", "pass", "partial", "fail"]
        },
        "verification_level": {
          "type": "string",
          "enum": ["V0", "V1", "V2", "V3"]
        },
        "preservation_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCheck"
          },
          "default": []
        },
        "realism_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCheck"
          },
          "default": []
        },
        "remaining_failures": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status"],
      "properties": {
        "check": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pass", "partial", "fail", "unverified", "not_applicable"]
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "source_ledger_ids": {
          "$ref": "#/$defs/stringList"
        },
        "classification": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CONFIRMED", "CORROBORATED", "MODEL-BEHAVIOR", "PROVIDER-SPECIFIC", "INFERRED"]
          },
          "uniqueItems": true,
          "default": []
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}