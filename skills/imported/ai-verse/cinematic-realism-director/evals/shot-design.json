{
  "schema_version": "1.1.0",
  "skill": "cinematic-realism-director",
  "purpose": "Verify that minimal beginner prompts are expanded into specialist professional-quality images without unnecessary questions, medium drift, arbitrary prestige tokens, or cinematic cliche stacking.",
  "scoring": {
    "pass_condition": "For each case, preserve literal content/medium, infer the correct professional specialty, apply the Professional Quality Floor, resolve shot design coherently, ask no unnecessary technical questions, run V0 Reality Gate, and satisfy all case invariants without requiring one exact camera/lens solution.",
    "critical_failures": [
      "asking a beginner to choose camera/lens/aperture/stock/light ratio/grade/provider when the prompt is sufficient",
      "changing literal subject/action/environment or requested medium",
      "returning merely ordinary competent photography because the user did not ask for professional/cinematic quality",
      "starting from prestige camera/lens names instead of intent and professional specialty",
      "forcing cinema-camera language onto explicit phone/selfie/mobile capture",
      "adding shallow depth, anamorphic flare, heavy grain, halation, haze, rim light, teal-orange or motion blur solely as cinematic decoration",
      "removing all subtle professional texture by default and leaving photographic work sterile/AI-clean",
      "using focal length as a substitute for camera position",
      "producing physically incoherent light/contact/reflection/shadow/material/depth behavior",
      "claiming V2 visual verification from prompt/reasoning only"
    ]
  },
  "global_invariants": {
    "must": [
      "extract subject/action/environment/requested or implied medium",
      "infer the appropriate professional specialty",
      "apply the Professional Quality Floor without requiring quality keywords",
      "choose viewer relationship and visual hierarchy",
      "design composition/camera position before focal length",
      "use motivated lighting and professional exposure/tonal response",
      "use professional color separation and material/skin realism",
      "use subtle organic filmic texture for most photographic output unless the medium/user calls for clean/no-grain output",
      "run Reality Gate V0 before provider adaptation",
      "choose execution path before adapter"
    ],
    "must_not": [
      "require named hardware",
      "invent user locks",
      "default every shot to shallow depth",
      "default every shot to obvious/heavy grain or film-emulation artifacts",
      "default every shot to haze/rim/flare/halation/teal-orange",
      "use empty quality adjectives instead of concrete professional decisions",
      "erase requested medium"
    ]
  },
  "cases": [
    {
