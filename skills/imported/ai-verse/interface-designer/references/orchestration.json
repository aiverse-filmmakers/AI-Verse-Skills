{
  "schema_version": 1,
  "capability": "interface-designer",
  "principle": "Load the smallest expert subset that satisfies the current scope, target, references, and verification needs.",
  "scopes": [
    "MICRO_CHANGE",
    "COMPONENT",
    "SCREEN",
    "MULTI_SCREEN_FLOW",
    "FULL_PRODUCT",
    "REFERENCE_RECREATION",
    "INTERACTION_HEAVY",
    "DESIGN_SYSTEM_CHANGE",
    "SCROLL_IMMERSIVE",
    "MOBILE_EXPO"
  ],
  "targets": [
    "PLAIN_HTML_CSS_JS_ARTIFACT",
    "EXISTING_WEB_STACK",
    "REACT_WEB_APP",
    "PWA",
    "FIGMA",
    "CANVA_OR_STATIC_DESIGN_TOOL",
    "DESKTOP_WEBVIEW_APP",
    "NATIVE_DESKTOP_APP",
    "REACT_NATIVE_EXPO",
    "PROTOTYPE_ONLY",
    "DESIGN_ONLY_HANDOFF",
    "CODE_DRIVEN_VIDEO_MOTION_HANDOFF"
  ],
  "stages": [
    {
      "id": "local_authority",
      "capabilities": [],
      "when": "always",
      "required": true
    },
    {
      "id": "target_detection",
      "capabilities": [],
      "when": "always",
      "required": true
    },
    {
      "id": "reference_analysis",
      "capabilities": [
        "video-to-superprompt",
        "stitched-full-page-capture"
      ],
      "when": "reference_present",
      "required": false,
      "select": "media_specific"
    },
    {
      "id": "design_specification",
      "capabilities": [
        "design-first-ui-prompting"
      ],
      "when": "brief_is_vague_or_builder_spec_needed",
      "required": false
    },
    {
      "id": "ui_ux_intelligence",
      "capabilities": [
        "ui-ux-pro-max"
      ],
      "when": "scope_is_substantial_or_design_system_changes",
      "required": false
    },
    {
      "id": "experience_curve",
      "capabilities": [],
      "when": "meaningful_multi_stage_experience",
      "required": false,
      "policy": "references/experience-curve-policy.json"
    },
    {
      "id": "visual_direction",
      "capabilities": [
        "frontend-design"
      ],
      "when": "new_or_changed_visual_direction",
      "required": false
    },
    {
      "id": "prototype_divergence",
      "capabilities": [
        "prototype"
      ],
      "when": "substantial_choice_is_ambiguous_or_options_requested",
      "required": false
    },
    {
      "id": "originality_gate",
      "capabilities": [],
      "when": "new_substantial_visual_direction_and_not_bypassed",
      "required": false,
      "policy": "references/originality-policy.json"
    },
    {
      "id": "signature_interaction",
      "capabilities": [],
      "when": "experience_surface_requires_distinctive_product_specific_interaction",
      "required": false,
      "policy": "references/signature-interaction-policy.json"
    },
    {
      "id": "design_system_persistence",
      "capabilities": [],
      "when": "persistent_product_visual_grammar_needed",
      "required": false,
      "artifact": "DESIGN.md"
    },
    {
      "id": "library_selection",
      "capabilities": [
        "pick-ui-library"
      ],
      "when": "new_ui_dependency_choice_needed",
      "required": false
    },
    {
      "id": "target_implementation",
      "capabilities": [],
      "when": "implementation_requested",
      "required": false,
      "select": "target_specific"
    },
    {
      "id": "interaction_physics",
      "capabilities": [
        "apple-design"
      ],
      "when": "direct_manipulation_gesture_or_spatial_physics",
      "required": false
    },
    {
      "id": "motion_build",
      "capabilities": [
        "animate"
      ],
      "when": "meaningful_ui_motion_required",
      "required": false
    },
    {
      "id": "render_preview",
      "capabilities": [],
      "when": "implementation_or_visual_output_exists",
      "required": false
    },
    {
      "id": "visual_state_qa",
      "capabilities": [],
      "when": "substantial_ui_or_changed_state_exists",
      "required": false,
      "policy": "references/visual-qa-policy.json",
      "evidence_required": true
    },
    {
      "id": "scroll_state_qa",
      "capabilities": [],
      "when": "scroll_is_primary_interaction_or_state_driver",
      "required": false,
      "policy": "references/scroll-qa-policy.json",
      "evidence_required": true
    },
    {
      "id": "motion_review",
      "capabilities": [
        "review-animations"
      ],
      "when": "significant_motion_exists",
      "required": false
    },
    {
      "id": "web_review",
      "capabilities": [
        "web-design-guidelines"
      ],
      "when": "substantial_web_ui_delivery",
      "required": false
    },
    {
      "id": "fix_and_reverify",
      "capabilities": [],
      "when": "any_gate_fails",
      "required": false
    }
  ],
  "target_experts": {
    "PLAIN_HTML_CSS_JS_ARTIFACT": [],
    "EXISTING_WEB_STACK": [],
    "REACT_WEB_APP": [
      "react-best-practices",
      "composition-patterns"
    ],
    "PWA": [],
    "FIGMA": [
      "figma-use",
      "figma-generate-design"
    ],
    "CANVA_OR_STATIC_DESIGN_TOOL": [
      "canva"
    ],
    "DESKTOP_WEBVIEW_APP": [],
    "NATIVE_DESKTOP_APP": [],
    "REACT_NATIVE_EXPO": [
      "animate-expo"
    ],
    "PROTOTYPE_ONLY": [
      "prototype"
    ],
    "DESIGN_ONLY_HANDOFF": [],
    "CODE_DRIVEN_VIDEO_MOTION_HANDOFF": [
      "video-editor"
    ]
  },
  "conditional_experts": {
    "shadcn": {
      "capability": "shadcn",
      "when": "components_json_present_or_shadcn_selected"
    },
    "scroll_craft": {
      "capability": "scroll-craft",
      "when": "scroll_is_primary_storytelling_or_interaction_mechanism"
    },
    "motion_audit": {
      "capability": "improve-animations",
      "when": "user_requests_existing_motion_audit_or_improvement"
    },
    "motion_opportunities": {
      "capability": "find-animation-opportunities",
      "when": "explicit_mature_product_polish_pass"
    }
  },
  "scope_pipelines": {
    "MICRO_CHANGE": [
      "local_authority",
      "target_detection",
      "target_implementation",
      "render_preview",
      "fix_and_reverify"
    ],
