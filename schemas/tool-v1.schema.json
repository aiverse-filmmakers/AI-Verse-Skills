{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiverse.local/schemas/tool-v1.schema.json",
  "title": "AI-Verse Tool Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "name",
    "version",
    "description",
    "input_schema",
    "output_schema",
    "effects",
    "idempotency",
    "network",
    "cancellable"
  ],
  "properties": {
    "contract": {
      "const": "aiverse-tool-v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "input_schema": {
      "$ref": "#/$defs/jsonSchemaObject"
    },
    "output_schema": {
      "$ref": "#/$defs/jsonSchemaObject"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "idempotency": {
      "enum": ["read-only", "idempotent", "conditional", "non-idempotent"]
    },
    "network": {
      "enum": ["deny", "read", "write", "runtime-policy"]
    },
    "cancellable": {
      "type": "boolean"
    },
    "streaming": {
      "type": "boolean",
      "default": false
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "supports_dry_run": {
      "type": "boolean",
      "default": false
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "connections": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "secret_handles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["linux", "macos", "windows"]}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description", "retryable"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "retryable": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "enum": [
        "none",
        "workspace.read",
        "workspace.write",
        "process.exec",
        "network.read",
        "network.write",
        "browser.read",
        "browser.write",
        "connector.read",
        "connector.write",
        "knowledge.propose",
        "knowledge.write",
        "git.local_write",
        "git.remote_write",
        "deploy.write",
        "secret.use"
      ]
    },
    "jsonSchemaObject": {
      "type": "object",
      "description": "Embedded JSON Schema for tool input or output."
    }
  }
}